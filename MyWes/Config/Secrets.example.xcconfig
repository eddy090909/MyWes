// Copy this file to Secrets.xcconfig (gitignored) and fill in values from
// Dashboard, Project Settings, API.
// Never put the service_role key in this file or the iOS app.
// xcconfig treats // as a comment, so write the URL as https:/$()/YOUR_PROJECT_REF.supabase.co

SUPABASE_URL = https:/$()/YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY = YOUR_SUPABASE_ANON_KEY
